function stg = stage_esc1_spice()
    stg = struct();
    stg.rds_on        = 0.00190339;   // Ohm, switch on-resistance, 25 degC
    stg.r_leg         = 0.00340339;   // Ohm, mean leg resistance (high side, low side + shunt)
    stg.vd            = 0.7272899;        // V, body diode at 2 A
    stg.dead_timer_ns = 500.0;          // ns, timer dead time
    stg.dead_eff_ns   = 132.64609027115077;          // ns, effective (driver and switch delays)
    stg.shunt_settle_ns = 344.62099999998054;        // ns, shunt settled, from the low-side timer edge
    stg.duty_max_sampling = 0.9562151600000007;   // largest leg duty with a valid current sample
endfunction
